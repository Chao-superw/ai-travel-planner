# Copy to .env for Docker Compose, or export variables for native startup.
# Never commit .env or real credentials.
# Every REPLACE_WITH_* value is a placeholder; replace it before startup.
# DATABASE_URL must use the password of your actual database account.
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DATABASE_URL=postgres://travel:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:15432/travel?sslmode=disable
PLANNER_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
BIGMODEL_API_KEY=REPLACE_WITH_BIGMODEL_API_KEY
BIGMODEL_MODEL=glm-5.3-flash
# Shared with FE VITE_AMAP_KEY by project decision; see ../UPLOAD_GUIDE.md.
AMAP_API_KEY=REPLACE_WITH_SHARED_AMAP_KEY
API_ADDR=127.0.0.1:8080
TRAVEL_ADDR=127.0.0.1:8888
PLANNER_ADDR=127.0.0.1:8889
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAPI_PATH=docs/openapi.yaml

# Email verification: generate AUTH_CODE_HMAC_KEY with openssl rand -hex 32.
# Keep this key stable across service replicas and restarts.
AUTH_CODE_HMAC_KEY=REPLACE_WITH_STABLE_RANDOM_HMAC_KEY
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=REPLACE_WITH_QQ_EMAIL_ADDRESS
SMTP_AUTH_CODE=REPLACE_WITH_QQ_SMTP_AUTH_CODE
MAIL_FROM=REPLACE_WITH_QQ_EMAIL_ADDRESS
SMTP_TIMEOUT_SECONDS=10
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_RESEND_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_SEND_EMAIL_HOUR=5
AUTH_SEND_IP_HOUR=100
AUTH_SEND_GLOBAL_HOUR=500
AUTH_VERIFY_EMAIL_HOUR=30
AUTH_VERIFY_IP_HOUR=300
AUTH_VERIFY_GLOBAL_HOUR=3000
AUTH_LOGIN_ACCOUNT_QUARTER=10
AUTH_LOGIN_IP_QUARTER=100
AUTH_LOGIN_GLOBAL_QUARTER=1000
